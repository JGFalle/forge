# ─────────────────────────────────────────────────────────────────────────────
# FORGE — environment variables
#
# Copy this file to .env and fill in your API keys.
# .env is gitignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic Claude API key
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Recommended (unlocks research features) ────────────────────────────────────

# Perplexity API key — enables ghost job detection, salary intel, council review
# Get one at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=ppl-...

# ── Optional features ──────────────────────────────────────────────────────────

# SerpApi key — enables Indeed/LinkedIn/Google job discovery scraping
# Get one at: https://serpapi.com/
SERPAPI_API_KEY=...

# Gmail App Password — enables discovery email digest and Gmail alert scraping
# Generate at: Google Account > Security > 2-Step Verification > App passwords
# Use this ONLY if you have 2FA enabled on the Gmail account
GMAIL_APP_PASSWORD=...

# LanguageTool API key — enables grammar checking in cover letter and ATS validator
# Free tier available at: https://languagetool.org/editor/settings/api
# Leave blank to use the free public endpoint (rate-limited)
# LANGUAGETOOL_API_KEY=
